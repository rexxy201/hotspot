# Copy this file to .env and fill in real values — or, better, just visit
# /setup.php on the server and let the wizard write it for you (it also
# offers a "test connection" button for each section below, so you find out
# immediately if a value is wrong instead of after an attendee can't log in).
#
# .env is gitignored — it must never be committed. config.php reads this
# file at runtime and is itself safe to commit (zero secrets in it).

# --- Database ---------------------------------------------------------
DB_HOST=localhost
DB_NAME=wifi_portal
DB_USER=wifi_portal_user
DB_PASS=

# --- App secret ---------------------------------------------------------
# Encrypts the RADIUS shared secret at rest (see lib/settings.php). Generate
# with: php -r "echo bin2hex(random_bytes(32));"
# Cannot be recovered if lost — you'd need to re-enter the RADIUS secret.
APP_KEY=

# --- Admin login ---------------------------------------------------------
# Generate with: php hash_password.php "your-strong-password"
ADMIN_PASSWORD_HASH=

# --- SMTP (email delivery) ---------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Wi-Fi Portal

# --- Twilio (SMS delivery) ----------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Mikrotik hotspot ---------------------------------------------------
# The router's hotspot gateway IP/hostname, e.g. 10.5.50.1. connect.php only
# auto-submits an attendee's credential to a link-login-only URL whose host
# exactly matches this value — required, or the SSRF check fails closed.
MIKROTIK_GATEWAY_HOST=

# This portal's own real hostname, e.g. eyifwifi.online — used when
# Admin > Wi-Fi & RADIUS generates the router config (.rsc) and hotspot
# login page (login.html) downloads. Optional: leave blank and those
# downloads fall back to auto-detecting the host from whichever request
# downloaded them.
PORTAL_HOST=

# --- Branding -------------------------------------------------------------
COMPANY_NAME=MangoNet

# --- Setup access -------------------------------------------------------
# Short PIN that unlocks setup.php on a re-run, instead of the admin
# password. Change it any time from the Security stage once unlocked.
SETUP_ACCESS_CODE=2112
