# config.php is committed — it's a safe loader with zero secrets in it.
# .env holds the real values and must never be committed.
.env
.env.*
!.env.example

vendor/
uploads/logos/*
!uploads/logos/.gitkeep

# Local dev server logs
php_err.log
php_out.log

logs/*
!logs/.gitkeep

# Written by the GitHub Actions deploy workflow on every push — server-only,
# read by almightypush.php.
deploy_info.json

# Generated by `graphify update .` — 2.4MB of derived index that rebuilds on
# every code change. Regenerate with `graphify update .` rather than tracking it.
graphify-out/

# Local editor/tooling config, not part of the deployable app.
.claude/

# macOS Finder metadata
.DS_Store
